{
  "mcpServers": {
    "jira": {
      "name": "Jira Management",
      "description": "Gestión completa de Jira - issues, proyectos, épicas",
      "type": "local",
      "command": "node",
      "args": ["/Users/jesus/jira-mcp-chat/mcp-server/index.js"],
      "enabled": true,
      "env": {
        "JIRA_BASE_URL": "https://aetherdev.atlassian.net",
        "JIRA_EMAIL": "leon.rodriguez.ore@gmail.com",
        "JIRA_API_TOKEN": "ATATT3xFfGF0rLuQf5K8ySjmT60YdZBz_SB3d6Qx88CUa7B2PMa35CjUOQviQLxH9g0MmSqdpGjFlflTHIp8AIL1bBP-bcdBMSSOKbuvpsKXR0sXHJX-zim_Jfja9CJSmYz4lGiJ8xm5LyjnpE8nIEGyrKtWNnUEZ24iSHlz96HRAMjxUZiTZuQ=04299DBA"
      }
    },
    "n8n-mcp": {
      "name": "n8n Workflow Management",
      "description": "Gestión de workflows y automatizaciones con n8n",
      "type": "local",
      "command": "n8n-mcp",
      "args": [],
      "enabled": true,
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    },
    "weather": {
      "name": "Weather Service",
      "description": "Información meteorológica en tiempo real",
      "type": "local",
      "command": "uv",
      "args": [
        "--directory",
        "/absolute/path/to/weather",
        "run",
        "weather.py"
      ],
      "enabled": false,
      "tools": [
        "get_current_weather",
        "get_forecast",
        "get_weather_alerts"
      ]
    },
    "database": {
      "name": "Database Tools", 
      "description": "Herramientas de gestión de base de datos",
      "type": "remote",
      "url": "ws://localhost:8080/mcp",
      "enabled": false,
      "tools": [
        "execute_query",
        "get_table_schema", 
        "backup_database"
      ],
      "auth": {
        "type": "bearer",
        "token": "${DB_API_TOKEN}"
      }
    },
    "github": {
      "name": "GitHub Integration",
      "description": "Gestión de repositorios y issues de GitHub",
      "type": "local",
      "command": "npx",
      "args": ["github-mcp-server"],
      "enabled": false,
      "tools": [
        "list_repositories",
        "create_issue",
        "get_pull_requests"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_ORG": "${GITHUB_ORG}"
      }
    }
  },
  "defaultServer": "jira",
  "settings": {
    "autoConnect": true,
    "timeout": 30000,
    "retryAttempts": 3,
    "loadBalancing": false
  },
  "ui": {
    "showServerStatus": true,
    "groupToolsByServer": true,
    "showToolDescriptions": true
  }
}
