# === CONFIGURACIÓN MCP ===
# Usar MCP stdio (true) o modo directo (false)
USE_STDIO_MCP=false

# Usar IA universal (múltiples proveedores)
USE_UNIVERSAL_AI=true

# Proveedor de IA por defecto
DEFAULT_AI_PROVIDER=ollama

# Modelo por defecto
DEFAULT_AI_MODEL=deepseek-coder:latest

# === CONFIGURACIÓN PERSONALIZADA ===
# Proyecto principal de tu organización
DEFAULT_PROJECT=DEV

# Lista de proyectos de tu equipo (separados por comas)
TEAM_PROJECTS=DEV,BUGS,INFRA,QA

# Nombre de tu organización
ORGANIZATION_NAME=Mi Empresa

# Zona horaria
TIMEZONE=America/Mexico_City

# === EJEMPLOS POR TIPO DE ORGANIZACIÓN ===

# 💻 STARTUP TECNOLÓGICA:
# DEFAULT_PROJECT=MVP
# TEAM_PROJECTS=MVP,PROD,BUGS,FEATURES
# ORGANIZATION_NAME=Mi Startup

# 🏢 EMPRESA GRANDE:
